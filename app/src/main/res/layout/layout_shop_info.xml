<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F9F9F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivShopLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="@color/green_primary"
            android:background="@drawable/bg_tab_container"
            android:backgroundTint="#E8F5E9"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShopName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Toko"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShopLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Penyewa Terverifikasi"
                android:textColor="@color/gray_text"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVisitShop"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kunjungi"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingHorizontal="12dp"
            app:strokeColor="@color/green_primary"
            android:textColor="@color/green_primary"
            app:cornerRadius="20dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>