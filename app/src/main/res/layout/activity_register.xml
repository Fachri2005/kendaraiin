
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#294669">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SPACE ATAS -->
        <View
            android:layout_width="match_parent"
            android:layout_height="90dp" />

        <!-- CONTAINER PUTIH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_top_round"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TAB -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#EFEFEF"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- LOGIN -->
                <Button
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#EFEFEF"
                    android:text="Masuk"
                    android:textAllCaps="false"
                    android:textColor="#7A7A7A"
                    android:textStyle="bold" />

                <!-- REGISTER -->
                <Button
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#294669"
                    android:text="Register"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Yuk, Daftar Sekarang!"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- SUBTITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Daftar sekarang dan mulai perjalananmu bersama kami."
                android:textColor="#8A8A8A"
                android:textSize="13sp" />

            <!-- ROLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Daftar Sebagai*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerRole"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:entries="@array/role_list"
                android:paddingHorizontal="12dp" />

            <!-- NAMA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nama Lengkap*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:hint="Masukkan nama lengkap..."
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Email*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:hint="Masukkan Email..."
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <!-- NOMOR TELEPON -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nomor Telepon*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:hint="Masukkan no telepon..."
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <!-- NOMOR DARURAT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nomor Telepon Darurat*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:hint="Masukkan no telepon darurat..."
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <!-- JENIS KELAMIN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Jenis Kelamin"
                android:textColor="#000000"
                android:textStyle="bold" />

            <Spinner
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:entries="@array/gender_list"
                android:paddingHorizontal="12dp" />

            <!-- TANGGAL LAHIR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tanggal Lahir*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:hint="Pilih Tanggal Lahir..."
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <!-- PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Password*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:hint="Masukkan password..."
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <!-- KONFIRMASI PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Konfirmasi Password*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:hint="Masukkan password..."
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <!-- BUTTON REGISTER -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#294669"
                android:text="Daftar Sekarang"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>