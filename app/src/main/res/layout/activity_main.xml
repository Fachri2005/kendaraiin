<!-- activity_login.xml -->
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#294669">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SPACE ATAS -->

        <!-- CONTAINER PUTIH -->
        <View
            android:layout_width="match_parent"
            android:layout_height="61dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_top_round"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TAB LOGIN REGISTER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#EFEFEF"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- BUTTON LOGIN -->
                <Button
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#294669"
                    android:text="Masuk"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <!-- BUTTON REGISTER -->
                <Button
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#EFEFEF"
                    android:text="Register"
                    android:textAllCaps="false"
                    android:textColor="#7A7A7A"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- JUDUL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Yuk, lanjutkan perjalananmu!"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- SUBTITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tinggal login, dan kita langsung jalan bareng lagi!"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Email*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:hint="Masukkan Email..."
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <!-- PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Password*"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_bg"
                android:hint="Masukkan password..."
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#A0A0A0" />

            <!-- LUPA PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="Lupa Password?"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- BUTTON LOGIN -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#294669"
                android:text="Masuk Sekarang"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <!-- GARIS ATAU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#D9D9D9" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:text="Atau"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#D9D9D9" />
            </LinearLayout>

            <!-- BUTTON GOOGLE -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_google"
                android:text="Masuk Dengan Google"
                android:textAllCaps="false"
                android:textColor="#000000" />

            <!-- BUTTON TAMU -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_google"
                android:text="Mode Tamu"
                android:textAllCaps="false"
                android:textColor="#8A8A8A" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>